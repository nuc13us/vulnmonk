# Backend Environment Variables

# JWT Configuration
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_DAYS=30

# Database Configuration
# Leave empty to use default: vulnmonk.db in project root
DATABASE_PATH=

# CORS Origins (comma-separated) — set to your frontend URL in production
CORS_ORIGINS=http://localhost:3000

# Frontend URL used to generate PR status links back to VulnMonk.
# Set this to the public URL of your frontend (for local dev, http://localhost:3000).
FRONTEND_URL=

# GitHub App credentials are configured from the UI at the Integrations page.
# Do not store GitHub App credentials in this file; the app is created and
# installed via the database-backed configuration flow.
# The app webhook URL should be: http://YOUR_SERVER:3000/api/webhooks/github

# Maximum number of PR scan history entries displayed per project
# Leave empty to use the default of 200
PR_SCAN_HISTORY_LIMIT=200

# PR scan findings log (JSON, one object per line, rotated at 10 MB x 5 files).
# Written to this file only; PR scan findings do not appear in `docker logs`.
# Leave empty to use the default: <DATABASE_PATH dir>/logs/pr_scans.log
# (in Docker that is /data/logs/pr_scans.log on the persistent vulnmonk-data volume).
PR_SCAN_LOG_FILE=

# Google SSO Configuration — optional, enables "Sign in with Google" on the login page
# See GOOGLE_SSO_SETUP.md for setup instructions
# Obtain from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
